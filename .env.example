# ============================================================
# KRTPedia · Supabase 环境变量模板
# 复制为 .env.local 并填写真实值（Vercel 上配置到 Environment Variables）
# ============================================================

# Supabase 项目 URL（Supabase 控制台 → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# 公开密钥（新版 publishable key 或旧版 anon key 二者任一即可）
# Vercel 上可配置 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY 或 NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 站点公开域名（用于 canonical / sitemap）
NEXT_PUBLIC_SITE_URL=https://krts-pedia.vercel.app