# QQ 官方机器人
QQ_APP_ID=
QQ_APP_SECRET=
# sandbox（沙箱） | production（正式）
QQ_ENV=sandbox

# Supabase（只读档案）
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 站娘账号（用于「代录词条/版式」写入，signInWithPassword 登录）
PETIA_EMAIL=petia@krt.local
PETIA_PASSWORD=

# DeepSeek
DEEPSEEK_API_KEY=

# 网站地址（生成档案链接）
SITE_URL=https://krts-pedia.vercel.app

# ===== OneBot 通道（NapCat 等框架，用于进 QQ 群）=====
# NapCat 正向 WebSocket 地址（默认 http 面板里配的端口）
QQ_ONEBOT_WS_URL=
# NapCat 里设置的 access_token（没设就留空）
QQ_ONEBOT_ACCESS_TOKEN=
